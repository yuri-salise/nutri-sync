# NutriSync-RAG Environment Variables Example
# Duplicate this file as .env for local development

# Application Configuration
APP_NAME=NutriSync-RAG
APP_ENV=development
APP_DEBUG=true
APP_VERSION=v1.0.0-dev
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_super_secure_random_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 17 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nutrisync_user
DB_PASSWORD=nutrisync_secure_password
DB_NAME=nutrisync_db
DATABASE_URL=postgresql+asyncpg://nutrisync_user:nutrisync_secure_password@localhost:5432/nutrisync_db
DATABASE_URL_SYNC=postgresql://nutrisync_user:nutrisync_secure_password@localhost:5432/nutrisync_db

# Frontend & CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:8080

# Public address: set PUBLIC_APP_URL to the Tailscale Funnel URL on the server,
# e.g. https://<machine>.<tailnet>.ts.net

# AI & RAG Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
USE_OLLAMA_FALLBACK=true

# Security & Rate Limiting
LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=60/minute

# Meal photo analysis (free tiers). Leave a key empty to skip that provider.
# Gemini key: https://aistudio.google.com/apikey  Groq key: https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
